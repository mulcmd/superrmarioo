<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Pocong Hunter - Petualangan Mistik 2D</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Creepster&family=Poppins:wght@400;600;800&display=swap');

        * {
            user-select: none;
            -webkit-user-select: none;
            touch-action: manipulation;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #050508;
            color: #ffffff;
            overflow: hidden;
        }

        .font-creepster {
            font-family: 'Creepster', cursive;
        }

        /* Responsive Canvas Aspect Ratio Container */
        #game-container {
            position: relative;
            width: 100vw;
            height: 100vh;
            max-width: 1280px;
            max-height: 720px;
            aspect-ratio: 16 / 9;
            box-shadow: 0 0 50px rgba(0, 255, 128, 0.2);
        }

        canvas {
            display: block;
            width: 100%;
            height: 100%;
            background-color: #0b0c10;
        }

        /* Screen Shake Animation */
        .shake {
            animation: shakeAnim 0.3s cubic-bezier(.36,.07,.19,.97) both;
        }

        @keyframes shakeAnim {
            10%, 90% { transform: translate3d(-3px, 0, 0); }
            20%, 80% { transform: translate3d(4px, 0, 0); }
            30%, 50%, 70% { transform: translate3d(-6px, 0, 0); }
            40%, 60% { transform: translate3d(6px, 0, 0); }
        }

        /* Touch Controls Styling */
        .btn-touch {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(5px);
            border: 2px solid rgba(255, 255, 255, 0.3);
            active: background rgba(255, 255, 255, 0.4);
        }
    </style>
</head>
